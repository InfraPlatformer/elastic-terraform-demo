# =============================================================================
# AWS-ONLY ELASTIC STACK INFRASTRUCTURE
# =============================================================================
# Simplified version for AWS-only deployment
# =============================================================================

# AWS Provider
provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = var.project_name
      Environment = var.environment
      ManagedBy   = "terraform"
      Owner       = var.owner
      Purpose     = "elastic-stack"
    }
  }
}

# Kubernetes Provider
provider "kubernetes" {
  config_path = "~/.kube/config"
}

# Helm Provider
provider "helm" {
  kubernetes {
    config_path = "~/.kube/config"
  }
}

# =============================================================================
# DATA SOURCES
# =============================================================================

# Get current AWS caller identity
data "aws_caller_identity" "current" {}

# Get current AWS region
data "aws_region" "current" {}

# Get availability zones
data "aws_availability_zones" "available" {
  state = "available"
}

# =============================================================================
# NETWORKING MODULE
# =============================================================================
module "aws_networking" {
  source = "./modules/networking"
  
  project_name = var.project_name
  environment  = var.environment
  aws_region   = var.aws_region
  
  vpc_cidr             = var.aws_vpc_cidr
  availability_zones   = data.aws_availability_zones.available.names
  public_subnet_cidrs  = ["10.0.0.0/24", "10.0.1.0/24"]
  private_subnet_cidrs = ["10.0.2.0/24", "10.0.3.0/24"]
  
  tags = {
    Name        = "${var.project_name}-${var.environment}-vpc"
    Environment = var.environment
    Purpose     = "networking"
  }
}

# =============================================================================
# EKS CLUSTER MODULE
# =============================================================================
module "aws_eks" {
  source = "./modules/eks"
  
  project_name = var.project_name
  environment  = var.environment
  aws_region   = var.aws_region
  
  vpc_id          = module.aws_networking.vpc_id
  private_subnets = module.aws_networking.private_subnet_ids
  public_subnets  = module.aws_networking.public_subnet_ids
  
  cluster_name    = var.cluster_name
  cluster_version = var.kubernetes_version
  
  node_groups = var.aws_node_groups
  
  tags = {
    Name        = "${var.project_name}-${var.environment}-eks"
    Environment = var.environment
    Purpose     = "kubernetes"
  }
}

# =============================================================================
# ELASTICSEARCH MODULE
# =============================================================================
module "elasticsearch" {
  source = "./modules/elasticsearch"
  
  project_name = var.project_name
  environment  = var.environment
  
  cluster_name = module.aws_eks.cluster_name
  namespace    = "elasticsearch"
  
  elasticsearch_version = "8.5.0"
  master_replicas      = 1
  data_replicas        = var.elasticsearch_data_nodes
  
  storage_class = "gp3"
  storage_size  = "100Gi"
  
  enable_security = true
  enable_ssl      = true
  
  tags = {
    Name        = "${var.project_name}-${var.environment}-elasticsearch"
    Environment = var.environment
    Purpose     = "search"
  }
}

# =============================================================================
# KIBANA MODULE
# =============================================================================
module "kibana" {
  source = "./modules/kibana"
  
  project_name = var.project_name
  environment  = var.environment
  
  cluster_name = module.aws_eks.cluster_name
  namespace    = "kibana"
  
  kibana_version = "8.5.0"
  replicas       = var.kibana_replicas
  
  elasticsearch_url = module.elasticsearch.elasticsearch_url
  
  enable_security = true
  enable_ssl      = true
  
  tags = {
    Name        = "${var.project_name}-${var.environment}-kibana"
    Environment = var.environment
    Purpose     = "visualization"
  }
}

# =============================================================================
# MONITORING MODULE
# =============================================================================
module "monitoring" {
  source = "./modules/monitoring"
  
  project_name = var.project_name
  environment  = var.environment
  
  cluster_name = module.aws_eks.cluster_name
  namespace    = "monitoring"
  
  enable_prometheus = true
  enable_grafana    = true
  
  elasticsearch_url = module.elasticsearch.elasticsearch_url
  
  tags = {
    Name        = "${var.project_name}-${var.environment}-monitoring"
    Environment = var.environment
    Purpose     = "monitoring"
  }
}

# =============================================================================
# OUTPUTS
# =============================================================================

# EKS Cluster Outputs
output "aws_cluster_info" {
  description = "AWS EKS cluster information"
  value = {
    name     = module.aws_eks.cluster_name
    arn      = module.aws_eks.cluster_arn
    endpoint = module.aws_eks.cluster_endpoint
    region   = var.aws_region
    version  = var.kubernetes_version
  }
}

# Networking Outputs
output "aws_networking_info" {
  description = "AWS networking information"
  value = {
    vpc_id          = module.aws_networking.vpc_id
    vpc_cidr        = var.aws_vpc_cidr
    public_subnets  = module.aws_networking.public_subnet_ids
    private_subnets = module.aws_networking.private_subnet_ids
  }
}

# Elasticsearch Outputs
output "elasticsearch_info" {
  description = "Elasticsearch information"
  value = {
    url      = module.elasticsearch.elasticsearch_url
    username = module.elasticsearch.elasticsearch_username
    password = module.elasticsearch.elasticsearch_password
  }
  sensitive = true
}

# Kibana Outputs
output "kibana_info" {
  description = "Kibana information"
  value = {
    url = module.kibana.kibana_url
  }
}

# Monitoring Outputs
output "monitoring_info" {
  description = "Monitoring information"
  value = {
    prometheus_url = module.monitoring.prometheus_url
    grafana_url    = module.monitoring.grafana_url
  }
}

# Connection Instructions
output "connection_instructions" {
  description = "Instructions for connecting to the cluster"
  value = {
    kubectl_config       = "aws eks update-kubeconfig --region ${var.aws_region} --name ${module.aws_eks.cluster_name}"
    port_forward_command = "kubectl port-forward -n elasticsearch svc/elasticsearch 9200:9200"
    elasticsearch_url    = "http://elasticsearch.elasticsearch.svc.cluster.local:9200"
  }
}

# Project Information
output "project_info" {
  description = "Project information"
  value = {
    name        = var.project_name
    environment = var.environment
    owner       = var.owner
    region      = var.aws_region
    version     = "1.0.0"
    managed_by  = "terraform"
  }
}
